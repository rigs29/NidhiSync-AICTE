"""
OCR & Document Intelligence Service (`backend/app/services/ocr_service.py`)
===========================================================================

Provides pure-Python document text extraction, scanned-document OCR fallback,
heuristic field parsing, submitted-vs-extracted comparison, scrutiny remark
synchronization, and metadata sanitization for the AICTE FDR Management Portal.

This module is decoupled from FastAPI HTTP routers and never fabricates values
when a document is empty, corrupted, unreadable, or when an external OCR engine
is unavailable.

Documented Extraction Result Format (`extract_fdr_fields_from_document`):
-------------------------------------------------------------------------
{
    "status": str,
        # One of:
        # - "EXTRACTED"                           (>=1 FDR field parsed from text)
        # - "MANUAL_REVIEW_REQUIRED"              (readable file, 0 matching FDR fields or scanned PDF without OCR)
        # - "OCR_ENGINE_UNAVAILABLE_MANUAL_REVIEW"(image/scanned PDF, but Tesseract is not installed)
        # - "EMPTY_OR_CORRUPTED_FILE"             (0 bytes, truncated stream, or invalid PDF/image structure)
    "source_modality": str,
        # One of: "PDF_TEXT_EXTRACTION", "SCANNED_PDF_OCR",
        #         "OPTICAL_CHARACTER_RECOGNITION", "UNSUPPORTED", "INVALID_FILE"
    "engine": str,
        # Engine identifier, e.g., "PYPDF_DIGITAL_TEXT_LAYER",
        # "PYPDF_EMBEDDED_IMAGE_TESSERACT_OCR", "PDF_UNCOMPRESSED_TEXT_STREAM",
        # "TESSERACT_IMAGE_OCR", "IMAGE_OCR_ENGINE_UNAVAILABLE", "NONE"
    "confidence": float,
        # Heuristic field-coverage score in [0.0, 0.95] (capped at 0.95 because
        # automated extraction is a review aid, never authoritative verification)
    "fields_extracted_count": int,
        # Number of structured fields extracted (0 to 5)
    "extracted_fields": {
        "fdr_number": Optional[str],
        "bank_name": Optional[str],
        "amount": Optional[float],
        "issue_date": Optional[str],     # ISO-8601 date string YYYY-MM-DD
        "maturity_date": Optional[str],  # ISO-8601 date string YYYY-MM-DD
    },
    "evidence_snippets": Dict[str, str],
        # Maps each extracted field name to the matched source text snippet
    "notice": str,
        # Human-readable explanation of extraction outcome or fallback reason
}
"""

